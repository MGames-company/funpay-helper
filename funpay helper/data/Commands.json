{"!\u043f\u0440\u043e\u0434\u0430\u0432\u0435\u0446": "\u041f\u043e\u0437\u0432\u0430\u043b \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430", "\u0421\u043f\u0430\u0441\u0438\u0431\u043e": "\u0412\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434 \u043f\u043e\u043c\u043e\u0447\u044c!", "!\u0418\u0433\u0440\u044b": "https://docs.google.com/document/d/1La-p0muYJjc3EfcwAHCBaxsecO1Gb9IvupkjZKxzSgA/edit?usp=drivesdk", "!\u041a\u043e\u043c\u0430\u043d\u0434\u044b": "\u0421\u043f\u0438\u0441\u043e\u043a \u043a\u043e\u043c\u0430\u043d\u0434:/n\u041a\u043e\u0434 - \u0432\u044b\u0434\u0430\u0451\u0442 \u043a\u043e\u0434 \u043e\u0442 steam \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430, \u0435\u0441\u043b\u0438 \u0432\u044b \u0435\u0433\u043e \u0430\u0440\u0435\u043d\u0434\u043e\u0432\u0430\u043b\u0438\n/n!\u0418\u0433\u0440\u044b - \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u0441\u044b\u043b\u043a\u0443 \u043d\u0430 \u0441\u043f\u0438\u0441\u043e\u043a \u0438\u0433\u0440."}